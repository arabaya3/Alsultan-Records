{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.staging*)",
      "Read(**/.env.production*)",
      "Read(**/backups-local/**)",
      "Edit(**/.env*)",
      "Read(**/supabase/.temp/**)",
      "Read(**/.ssh/**)",
      "Read(**/com.vercel.cli/**)",
      "Read(**/.git-credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
