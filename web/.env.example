# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npx supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server only. Bypasses RLS. Never expose to the browser.
# Album storage (server only, never NEXT_PUBLIC_). ALBUM_STORAGE_WRITE=s3 sends new album uploads to S3; unset = Supabase.
# ALBUM_STORAGE_WRITE=s3
# S3_ENDPOINT=https://nbg1.your-objectstorage.com
# S3_REGION=nbg1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Cloudflare Turnstile (public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: HMAC key (>=32 chars) for hashing client IPs before rate limiting
IP_HASH_SECRET=

# Header set by the hosting edge with the real client IP (e.g. cf-connecting-ip, x-vercel-forwarded-for).
# Unset = right-most X-Forwarded-For entry.
CLIENT_IP_HEADER=

# Server only. Shared secret for POST /api/jobs/process-photos (header x-jobs-secret); also stored in
# Supabase Vault as `jobs_secret` for the pg_cron caller. >= 32 random chars.
JOBS_SECRET=
